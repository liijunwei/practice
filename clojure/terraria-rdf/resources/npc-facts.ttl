# 依据 /Users/me/Downloads/terraria_npcs.ttl.zip 校准；
# 生物群系偏好走 *Biome 属性，邻居偏好走 *Neighbor 属性。

terraria:Guide a terraria:NPC ;
    rdfs:label "向导"@zh ;
    terraria:likesBiome terraria:Forest ;
    terraria:dislikesBiome terraria:Ocean ;
    terraria:likesNeighbor terraria:Clothier ;
    terraria:likesNeighbor terraria:Zoologist ;
    terraria:dislikesNeighbor terraria:Steampunker ;
    terraria:hatesNeighbor terraria:Painter .

