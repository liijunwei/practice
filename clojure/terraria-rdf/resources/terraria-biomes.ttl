@prefix rdf:      <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs:     <http://www.w3.org/2000/01/rdf-schema#> .
@prefix terraria: <https://terraria.example.org/ontology#> .

terraria:Forest a terraria:Biome ;
    rdfs:label "森林"@zh .

terraria:Desert a terraria:Biome ;
    rdfs:label "沙漠"@zh .

terraria:Snow a terraria:Biome ;
    rdfs:label "雪原"@zh .

terraria:Jungle a terraria:Biome ;
    rdfs:label "丛林"@zh .

terraria:Ocean a terraria:Biome ;
    rdfs:label "海洋"@zh .

terraria:Hallow a terraria:Biome ;
    rdfs:label "神圣"@zh .

terraria:Cave a terraria:Biome ;
    rdfs:label "洞穴"@zh .

terraria:Corruption a terraria:Biome ;
    rdfs:label "腐化"@zh .

terraria:Crimson a terraria:Biome ;
    rdfs:label "猩红"@zh .
